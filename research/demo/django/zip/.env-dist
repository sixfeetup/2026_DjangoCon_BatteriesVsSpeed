# Database settings
PGDATABASE=postgres
PGHOST=db
PGPASSWORD=""
PGPORT=5432
PGUSER=postgres

# ALLOWED_HOSTS can be a comma-delimited string/list of host names
ALLOWED_HOSTS=localhost,web

DJANGO_DEBUG=true

# Don't use this secret key in production obviously
SECRET_KEY="top-secret"

# Declare we're developing local
LOCAL_DEVELOPMENT=true

# Local fallback runtime. Benchmark scripts render committed presets instead.
RUNTIME_LABEL=local-sync
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKER_CLASS=sync
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=2
GUNICORN_ACCESS_LOG_ENABLED=false
LOG_LEVEL=ERROR

# Database settings
PGDATABASE=postgres
PGHOST=db
PGPASSWORD=""
PGPORT=5432
PGUSER=postgres

# ALLOWED_HOSTS can be a comma-delimited string/list of host names
ALLOWED_HOSTS=localhost,127.0.0.1,api

DJANGO_DEBUG=false
BENCHMARK_MODE=true
# Serve built application and Django admin static assets under Gunicorn.
USE_WHITENOISE=true

# Don't use this secret key in production obviously
SECRET_KEY="top-secret"

# Declare we're developing local
LOCAL_DEVELOPMENT=true

# Canonical dataset readiness contract. The generated dataset.env supplies real
# values during benchmark runs; placeholders must never report ready.
ZELLIT_DATASET_SCHEMA_VERSION=unset
ZELLIT_DATASET_DIGEST=unset
ZELLIT_EXPECTED_ZIP_CODES=0
ZELLIT_EXPECTED_ACTORS=0
ZELLIT_EXPECTED_LISTINGS=0
ZELLIT_EXPECTED_PHOTOS=0
ZELLIT_EXPECTED_COMMENTS=0
ZELLIT_EXPECTED_LISTING_VOTES=0
ZELLIT_EXPECTED_COMMENT_VOTES=0

# Local fallback runtime. Measurement scripts generate these values from
# runtime-presets.json and pass the resulting file to `docker compose --env-file`.
RUNTIME_LABEL=local-sync
DJANGO_DATABASE_MODE=standard
DJANGO_CONN_MAX_AGE=60
DJANGO_GEVENT_POOL_MAX=20
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKER_CLASS=sync
GUNICORN_WORKERS=1
GUNICORN_THREADS=1
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=2
GUNICORN_ACCESS_LOG_ENABLED=false
DJANGO_LOG_LEVEL=ERROR
